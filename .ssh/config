# Read more about SSH config files:
# https://linux.die.net/man/5/ssh_config
# https://linuxize.com/post/using-the-ssh-config-file/

# Personal
Host ac alpha-centauri
  HostName 10.0.0.1
  User james
  IdentityFile ~/.ssh/id_ed25519

Host local-ac
  HostName 192.168.0.2
  User james
  IdentityFile ~/.ssh/id_ed25519

Host polaris polaris.frost.cx
  HostName 192.168.0.3
  User james
  IdentityFile ~/.ssh/id_ed25519

Host vega vega.frost.cx
  HostName vega.frost.cx
  User root
  IdentityFile ~/.ssh/id_ed25519

# Met Office
Host cazld*
  HostName %h.spice.sc.metoffice.gov.uk

Host ex*
  HostName login.%h.sc.metoffice.gov.uk

Host monsoon*
  User james.frost.mon
  IdentityFile ~/.ssh/id_ed25519_monsoon3
  ForwardX11 yes
  ForwardX11Trusted yes

Host monsoonlander
  Hostname lander1.collab.sc.metoffice.gov.uk
  ControlPath ~/.ssh/master-monsoon-%C
  ControlMaster auto
  ControlPersist 600

Host monsooncylc
  Hostname cazccylc1
  ProxyJump monsoonlander

Host monsoonhpc
  Hostname login
  ProxyJump monsoonlander

# JASMIN
Host login.jasmin.ac.uk
  User jfrost
  IdentityFile ~/.ssh/id_ecdsa_jasmin
  ForwardAgent yes
  ControlPath ~/.ssh/master-jasmin-%C
  ControlMaster auto
  ControlPersist 600

Host sci*.jasmin.ac.uk
  User jfrost
  ProxyJump login.jasmin.ac.uk
